<mxfile host="app.diagrams.net">
  <diagram id="tsa-flow" name="timeseries-analysis 分析流程">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1000" pageHeight="2120" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="S" value="開始：帶時間戳記的資料" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="290" y="20" width="220" height="44" as="geometry" /></mxCell>
        <mxCell id="H" value="1　資料健康檢查&#xA;結構、摘要統計、缺失、合理性&#xA;（時間資料結構自動建立）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="250" y="100" width="300" height="70" as="geometry" /></mxCell>
        <mxCell id="G" value="確認分析目標&#xA;要不要考慮外生變數？&#xA;要：預設用資料中其他欄位" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="250" y="200" width="300" height="70" as="geometry" /></mxCell>
        <mxCell id="PS" value="預測設定（要做預測時）&#xA;截止日、訓練窗（附下限）&#xA;預測期數（附上限）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="250" y="300" width="300" height="80" as="geometry" /></mxCell>
        <mxCell id="MISS" value="資料有缺失？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#2e7d32;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="290" y="410" width="220" height="80" as="geometry" /></mxCell>
        <mxCell id="IMP" value="2　缺失值處理&#xA;列出選項與依據，由使用者選&#xA;有樣本外時只用訓練段" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="660" y="415" width="300" height="70" as="geometry" /></mxCell>
        <mxCell id="V" value="3　視覺化探索（原始尺度）&#xA;原始序列走勢圖（第一張圖）、ACF" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f2fd;strokeColor=#1565c0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="250" y="530" width="300" height="60" as="geometry" /></mxCell>
        <mxCell id="VR" value="變異數（波動幅度）&#xA;隨水準增大？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#2e7d32;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="280" y="620" width="240" height="90" as="geometry" /></mxCell>
        <mxCell id="LOG" value="對數或 Box–Cox&#xA;轉換前後各算一次分段標準差" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f2fd;strokeColor=#1565c0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="660" y="635" width="300" height="60" as="geometry" /></mxCell>
        <mxCell id="SEAS" value="明顯季節性？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#2e7d32;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="290" y="740" width="220" height="80" as="geometry" /></mxCell>
        <mxCell id="SN" value="季節處理確認&#xA;預設不處理&#xA;由使用者決定 D" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="30" y="745" width="220" height="70" as="geometry" /></mxCell>
        <mxCell id="STA" value="4　平穩性檢定&#xA;ADF 與 KPSS" style="rhombus;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#2e7d32;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="270" y="860" width="260" height="100" as="geometry" /></mxCell>
        <mxCell id="DIFF" value="一般差分 d&#xA;差分後重驗" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f2fd;strokeColor=#1565c0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="20" y="880" width="170" height="60" as="geometry" /></mxCell>
        <mxCell id="UNC" value="結果衝突（情況三／四）&#xA;並陳結果，由使用者決定 d" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="660" y="875" width="300" height="70" as="geometry" /></mxCell>
        <mxCell id="ID" value="5　均值方程&#xA;給使用者看 ACF／PACF／EACF&#xA;依 ar() 與圖表建議階數" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff3e0;strokeColor=#ef6c00;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="250" y="1000" width="300" height="80" as="geometry" /></mxCell>
        <mxCell id="PICK" value="使用者選 2–3 個候選（不含 ARMA(0,0)）&#xA;有外生變數：迴歸加 ARIMA 誤差（誤差須有階數）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="250" y="1110" width="300" height="60" as="geometry" /></mxCell>
        <mxCell id="FIT" value="配適與比較&#xA;依使用者選的準則（AIC／BIC）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="250" y="1200" width="300" height="60" as="geometry" /></mxCell>
        <mxCell id="LB" value="6　殘差白噪音？&#xA;Ljung–Box Q(10)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#2e7d32;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="270" y="1290" width="260" height="100" as="geometry" /></mxCell>
        <mxCell id="ARCH" value="ARCH 效應？&#xA;殘差平方 ACF＋Q(10)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#2e7d32;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="260" y="1430" width="280" height="100" as="geometry" /></mxCell>
        <mxCell id="M1" value="模型定案：ARIMA&#xA;（或迴歸加 ARIMA 誤差）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f3e5f5;strokeColor=#6a1b9a;strokeWidth=2;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="660" y="1450" width="300" height="60" as="geometry" /></mxCell>
        <mxCell id="GA" value="GARCH 建模&#xA;樣本數檢查；從 GARCH(1,1) 起手&#xA;比較常態／Student-t 等誤差分布" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff3e0;strokeColor=#ef6c00;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="250" y="1570" width="300" height="80" as="geometry" /></mxCell>
        <mxCell id="GC" value="標準化殘差診斷&#xA;Q(10)、QQ 圖" style="rhombus;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#2e7d32;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="270" y="1690" width="260" height="100" as="geometry" /></mxCell>
        <mxCell id="M2" value="模型定案：ARIMA-GARCH&#xA;（或迴歸加 GARCH 誤差）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f3e5f5;strokeColor=#6a1b9a;strokeWidth=2;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="250" y="1830" width="300" height="60" as="geometry" /></mxCell>
        <mxCell id="FC" value="7　預測&#xA;多步預測區間&#xA;固定參數一步預測（有樣本外時）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f3e5f5;strokeColor=#6a1b9a;strokeWidth=2;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="250" y="1925" width="300" height="70" as="geometry" /></mxCell>
        <mxCell id="OUT" value="交付：report.qmd＋HTML＋乾淨資料" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="250" y="2030" width="300" height="50" as="geometry" /></mxCell>
        <mxCell id="lg0" value="圖例" style="text;html=1;whiteSpace=wrap;align=left;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="100" width="160" height="20" as="geometry" /></mxCell>
        <mxCell id="lg1" value="使用者決定／確認" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="20" y="125" width="170" height="30" as="geometry" /></mxCell>
        <mxCell id="lg2" value="處理步驟" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f2fd;strokeColor=#1565c0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="20" y="165" width="170" height="30" as="geometry" /></mxCell>
        <mxCell id="lg3" value="建模" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff3e0;strokeColor=#ef6c00;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="20" y="205" width="170" height="30" as="geometry" /></mxCell>
        <mxCell id="lg4" value="判斷" style="rhombus;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#2e7d32;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="20" y="245" width="170" height="40" as="geometry" /></mxCell>
        <mxCell id="lg5" value="模型定案／預測" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f3e5f5;strokeColor=#6a1b9a;strokeWidth=2;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="295" width="170" height="30" as="geometry" /></mxCell>
        <mxCell id="lg6" value="每個階段做完，先給使用者看結果、確認後再往下" style="text;html=1;whiteSpace=wrap;align=left;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="335" width="190" height="40" as="geometry" /></mxCell>
        <mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="S" target="H"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="H" target="G"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="G" target="PS"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="PS" target="MISS"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e5" value="是" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="MISS" target="IMP"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e6" value="否" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="MISS" target="V"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e7" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;exitX=0.5;exitY=1;entryX=1;entryY=0.5;" edge="1" parent="1" source="IMP" target="V"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="810" y="560" /></Array></mxGeometry></mxCell>
        <mxCell id="e8" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="V" target="VR"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e9" value="是" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="VR" target="LOG"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e10" value="否" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="VR" target="SEAS"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e11" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="LOG" target="SEAS"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="810" y="725" /><mxPoint x="400" y="725" /></Array></mxGeometry></mxCell>
        <mxCell id="e12" value="是" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="SEAS" target="SN"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e13" value="否" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="SEAS" target="STA"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e14" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="SN" target="STA"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="140" y="845" /><mxPoint x="400" y="845" /></Array></mxGeometry></mxCell>
        <mxCell id="e15" value="非平穩（情況二）" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="STA" target="DIFF"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e16" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;exitX=0.5;exitY=0;entryX=0.5;entryY=0;" edge="1" parent="1" source="DIFF" target="STA"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="105" y="845" /><mxPoint x="400" y="845" /></Array></mxGeometry></mxCell>
        <mxCell id="e17" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="STA" target="UNC"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e18" value="平穩（情況一）" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="STA" target="ID"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e19" value="使用者決定 d" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;exitX=0.5;exitY=1;entryX=1;entryY=0.5;" edge="1" parent="1" source="UNC" target="ID"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="810" y="1040" /></Array></mxGeometry></mxCell>
        <mxCell id="e20" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="ID" target="PICK"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e21" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="PICK" target="FIT"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e22" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="FIT" target="LB"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e23" value="否：調整階數" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;exitX=0;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="LB" target="ID"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="150" y="1340" /><mxPoint x="150" y="1040" /></Array></mxGeometry></mxCell>
        <mxCell id="e24" value="是" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="LB" target="ARCH"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e25" value="無（波動度固定）" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="ARCH" target="M1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e26" value="有（波動聚集）" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="ARCH" target="GA"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e27" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="GA" target="GC"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e28" value="未通過：調整階數或誤差分布" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;exitX=0;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="GC" target="GA"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="150" y="1740" /><mxPoint x="150" y="1610" /></Array></mxGeometry></mxCell>
        <mxCell id="e29" value="通過" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="GC" target="M2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e30" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="M2" target="FC"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e31" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;exitX=0.5;exitY=1;entryX=1;entryY=0.5;" edge="1" parent="1" source="M1" target="FC"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="810" y="1960" /></Array></mxGeometry></mxCell>
        <mxCell id="e32" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="FC" target="OUT"><mxGeometry relative="1" as="geometry" /></mxCell>
