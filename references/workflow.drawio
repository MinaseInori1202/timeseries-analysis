<mxfile host="app.diagrams.net">
  <diagram id="tsa-flow" name="timeseries-analysis 分析流程">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="2894" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- 起點與開場提問 -->
        <mxCell id="n0" value="收到帶時間戳記的資料" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="300" y="200" width="200" height="40" as="geometry" /></mxCell>
        
        
        
        

        <!-- 階段 1~3 -->
        <mxCell id="n2" value="1　資料健康檢查&#xA;• 時間欄、頻率、間隔、缺失、單位、合理性&#xA;• 多個數值欄位→先問分析哪個變數&#xA;• 多對象長表→先問是否協助整理" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="240" y="288" width="320" height="96" as="geometry" /></mxCell>
        <mxCell id="n3" value="3　建立時間資料結構&#xA;預設 ts／xts；可選 tsibble" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="270" y="644" width="260" height="50" as="geometry" /></mxCell>
        <mxCell id="nPS" value="預測設定（要做預測時）&#xA;訓練截止日、訓練窗長度&#xA;預測期數（說明上限）、預測方式&#xA;每項給選項，由使用者決定" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="270" y="414" width="260" height="80" as="geometry" /></mxCell>
        <mxCell id="n4" value="4　視覺化探索（原始尺度）&#xA;原始序列走勢圖（第一張圖）、落後圖／ACF" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="270" y="724" width="260" height="60" as="geometry" /></mxCell>
        <mxCell id="d2" value="變異數（波動幅度）&#xA;隨水準增大？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="280" y="814" width="240" height="90" as="geometry" /></mxCell>
        <mxCell id="nT" value="變異數穩定：對數或 Box–Cox&#xA;轉換前後各算一次分段標準差" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="620" y="829" width="260" height="60" as="geometry" /></mxCell>
        <mxCell id="n5" value="轉換後序列的自相關與分布&#xA;（未轉換則用原序列）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="270" y="944" width="260" height="60" as="geometry" /></mxCell>

        <!-- 階段 4 -->
        
        <mxCell id="d3" value="資料有缺失？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="290" y="524" width="220" height="80" as="geometry" /></mxCell>
        <mxCell id="nM" value="2　缺失值處理&#xA;先判斷缺失是否帶有資訊，列出選項與依據&#xA;由使用者決定並記錄&#xA;有樣本外時只用訓練段" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="620" y="524" width="300" height="80" as="geometry" /></mxCell>

        <!-- 階段 5 -->
        <mxCell id="n7" value="5　平穩性檢定&#xA;先看圖選 c（無趨勢）或 ct（有趨勢）&#xA;ADF 與 KPSS 兩者都做&#xA;（處理季節時，對季節差分後的序列檢定）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="200" y="1324" width="380" height="90" as="geometry" /></mxCell>
        <mxCell id="d4" value="有明顯季節性？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="290" y="1044" width="220" height="80" as="geometry" /></mxCell>
        <mxCell id="nS" value="季節性處理確認&#xA;偵測到明顯季節性，本 skill 預設不處理&#xA;是否納入季節差分 D？" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="620" y="1034" width="300" height="70" as="geometry" /></mxCell>
        
        <mxCell id="n9" value="平穩後畫 ACF／PACF，識別階數" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="270" y="1584" width="260" height="50" as="geometry" /></mxCell>

        <!-- 建模銜接 -->
        
        
        
        
        <mxCell id="n10" value="候選模型：ARIMA／SARIMA&#xA;依 ACF／PACF 人工定階（可選 auto.arima）&#xA;與使用者確認要配哪些（不含 ARMA(0,0)）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="230" y="1704" width="340" height="70" as="geometry" /></mxCell>
        <mxCell id="n11" value="7　殘差診斷第一層（一階動差）&#xA;Ljung–Box，type = &quot;Ljung-Box&quot;，m = 10（季節資料涵蓋一個週期）&#xA;H₀：殘差為白噪音" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="250" y="1904" width="300" height="70" as="geometry" /></mxCell>
        <mxCell id="d7" value="殘差平方有 ARCH 效應？&#xA;（第二層，二階動差）" style="rhombus;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="270" y="2124" width="260" height="90" as="geometry" /></mxCell>
        <mxCell id="nG" value="GARCH 1　定階&#xA;檢視殘差平方的 PACF&#xA;從 GARCH(1,1) 起手" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="600" y="2119" width="340" height="70" as="geometry" /></mxCell>

        <!-- 交付 -->
        <mxCell id="n12" value="交付：report.qmd＋HTML（程式碼可折疊）＋乾淨資料" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="250" y="2694" width="300" height="60" as="geometry" /></mxCell>
        <mxCell id="n13" value="完成" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="350" y="2784" width="100" height="40" as="geometry" /></mxCell>

        <!-- 圖例 -->
        <mxCell id="lg0" value="圖例" style="text;html=1;align=left;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="300" width="120" height="20" as="geometry" /></mxCell>
        <mxCell id="lg1" value="處理步驟" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="20" y="325" width="140" height="30" as="geometry" /></mxCell>
        <mxCell id="lg2" value="判斷（是／否）" style="rhombus;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="20" y="365" width="140" height="40" as="geometry" /></mxCell>
        <mxCell id="lg3" value="需使用者確認／回覆／交付" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="20" y="415" width="190" height="30" as="geometry" /></mxCell>
        
        <mxCell id="lg5" value="每個階段做完，先給使用者看結果、確認後再往下" style="text;html=1;whiteSpace=wrap;align=left;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="460" width="190" height="40" as="geometry" /></mxCell>

        <!-- 連線：主幹 -->
        <mxCell id="e01" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="n0" target="n2"><mxGeometry relative="1" as="geometry" /></mxCell>
        
        
        
        
        
        <mxCell id="e07" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="n2" target="nPS"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e08" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="nPS" target="d3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e08b" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="n3" target="n4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e09" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="n4" target="d2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e10" value="是" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="d2" target="nT"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e11" value="否：不轉換" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="d2" target="n5"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e12" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;exitX=0.5;exitY=1;entryX=1;entryY=0.5;" edge="1" parent="1" source="nT" target="n5"><mxGeometry relative="1" as="geometry" /></mxCell>
        
        
        <mxCell id="e15" value="是" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="d3" target="nM"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e16" value="否：報告不設缺失值章節" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="d3" target="n3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e17" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="nM" target="n3"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="770" y="624" /><mxPoint x="400" y="624" /></Array></mxGeometry></mxCell>
        <mxCell id="e18" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="n7" target="dK"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e19" value="是" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="d4" target="nS"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e20" value="否" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="d4" target="n7"><mxGeometry relative="1" as="geometry" /></mxCell>
        
        
        <mxCell id="e23" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="n9" target="n10"><mxGeometry relative="1" as="geometry" /></mxCell>
        
        
        
        
        
        <mxCell id="e29" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="n10" target="nF"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e30" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="n11" target="dL"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e31" value="是" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="d7" target="nG"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e32" value="否：寫明波動度固定、不需 GARCH" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="d7" target="nP"><mxGeometry relative="1" as="geometry" /></mxCell>
        
        
        <mxCell id="e35" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="n12" target="n13"><mxGeometry relative="1" as="geometry" /></mxCell>
      <mxCell id="dK" value="ADF 與 KPSS&#xA;結果組合？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="250" y="1444" width="300" height="100" as="geometry" /></mxCell><mxCell id="dL" value="Ljung–Box p &gt; 0.05？&#xA;（殘差無自相關）" style="rhombus;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="280" y="2004" width="240" height="90" as="geometry" /></mxCell><mxCell id="e36" value="情況一：平穩（ct 設定時為趨勢平穩）" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="dK" target="n9"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e37" value="情況二：非平穩，差分後重驗" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;exitX=0;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="dK" target="n7"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="205" y="1494" /><mxPoint x="205" y="1369" /></Array></mxGeometry></mxCell><mxCell id="e38" value="是" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="dL" target="d7"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e39" value="否：調整後重配適" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;exitX=0;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="dL" target="n9"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="110" y="2049" /><mxPoint x="110" y="1609" /></Array></mxGeometry></mxCell><mxCell id="e13" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="n5" target="d4"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="nSD" value="給季節差分 D 的建議（auto.arima）&#xA;附 ACF／PACF 圖，由使用者決定" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="620" y="1214" width="300" height="60" as="geometry" /></mxCell><mxCell id="e21c" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;exitX=0.2;exitY=1;entryX=1;entryY=0.5;" edge="1" parent="1" source="nSD" target="n7"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="680" y="1369" /></Array></mxGeometry></mxCell><mxCell id="nF" value="6　配適與比較&#xA;Arima() 配適 2–3 個候選模型&#xA;依使用者選定的選模準則比較（先問）&#xA;差分階數不同的模型，分數不可直接比" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="230" y="1794" width="340" height="90" as="geometry" /></mxCell><mxCell id="nP" value="8　預測與預測區間圖&#xA;採用預測設定的期數 h 與預測方式&#xA;給出點預測與 95% 預測區間圖" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="240" y="2554" width="320" height="80" as="geometry" /></mxCell><mxCell id="e29b" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="nF" target="n11"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e34" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="nP" target="n12"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="nU" value="情況三／四：結果衝突&#xA;• 檢查趨勢、異常點與明顯轉折&#xA;• 確認 c／ct 設定與圖形一致&#xA;• 並陳結果，由使用者決定 d" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="620" y="1449" width="320" height="90" as="geometry" /></mxCell><mxCell id="e40" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="dK" target="nU"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e41" value="改設定重做" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;exitX=0.5;exitY=0;entryX=1;entryY=0.5;" edge="1" parent="1" source="nU" target="n7"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="780" y="1369" /></Array></mxGeometry></mxCell><mxCell id="e42" value="使用者決定 d" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;exitX=0.5;exitY=1;entryX=1;entryY=0.5;" edge="1" parent="1" source="nU" target="n9"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="780" y="1609" /></Array></mxGeometry></mxCell><mxCell id="nG2" value="GARCH 2　估計&#xA;條件最大概似，均值與波動度一起估&#xA;比較常態／Student-t／skewed-t／GED 分布" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="600" y="2224" width="340" height="80" as="geometry" /></mxCell><mxCell id="nG3" value="GARCH 3　模型檢查&#xA;標準化殘差與其平方：Ljung–Box Q(10)、Q(20)&#xA;偏態、峰態、QQ 圖檢查分布假設" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="600" y="2339" width="340" height="80" as="geometry" /></mxCell><mxCell id="dG" value="殘差為白噪音&#xA;且符合分布假設？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="620" y="2454" width="300" height="90" as="geometry" /></mxCell><mxCell id="eG1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="nG" target="nG2"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="eG2" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="nG2" target="nG3"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="eG3" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="nG3" target="dG"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="eG4" value="是" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;exitX=0.5;exitY=1;entryX=1;entryY=0.5;" edge="1" parent="1" source="dG" target="nP"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="770" y="2594" /></Array></mxGeometry></mxCell><mxCell id="eG5" value="否：調整後重配適" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;exitX=1;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="dG" target="nG"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="965" y="2499" /><mxPoint x="965" y="2154" /></Array></mxGeometry></mxCell><mxCell id="e21e" value="要處理" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="nS" target="nSD"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e21f" value="不處理" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="nS" target="n7"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="600" y="1069" /><mxPoint x="600" y="1369" /></Array></mxGeometry></mxCell></root>
    </mxGraphModel>
  </diagram>
</mxfile>
