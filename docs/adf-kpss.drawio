<mxfile host="app.diagrams.net">
  <diagram id="adf-kpss" name="ADF 與 KPSS 的四種情況">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1000" pageHeight="720" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="P" value="先看序列圖，選 c（無趨勢）或 ct（有趨勢）&#xA;ADF 與 KPSS 用對應的設定" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f2fd;strokeColor=#1565c0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="300" y="20" width="400" height="60" as="geometry" /></mxCell>
        <mxCell id="R" value="兩個檢定&#xA;的結果？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#2e7d32;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="410" y="110" width="180" height="90" as="geometry" /></mxCell>
        <mxCell id="C1" value="情況一：ADF 拒絕、KPSS 不拒絕&#xA;平穩，d = 0" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f2fd;strokeColor=#1565c0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="10" y="260" width="230" height="70" as="geometry" /></mxCell>
        <mxCell id="C2" value="情況二：ADF 不拒絕、KPSS 拒絕&#xA;非平穩：差分後重新看圖、&#xA;重選 c／ct、再檢定" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f2fd;strokeColor=#1565c0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="260" y="260" width="230" height="70" as="geometry" /></mxCell>
        <mxCell id="C3" value="情況三：兩者都不拒絕&#xA;資訊不足：增加樣本、&#xA;看異常點與轉折" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f2fd;strokeColor=#1565c0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="510" y="260" width="230" height="70" as="geometry" /></mxCell>
        <mxCell id="C4" value="情況四：兩者都拒絕&#xA;趨勢平穩或分數整合：&#xA;檢查 c／ct、可嘗試去趨勢" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f2fd;strokeColor=#1565c0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="760" y="260" width="230" height="70" as="geometry" /></mxCell>
        <mxCell id="T" value="用的是&#xA;ct 設定？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#2e7d32;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="35" y="400" width="180" height="90" as="geometry" /></mxCell>
        <mxCell id="TS" value="趨勢平穩：先處理趨勢&#xA;不能直接以 d = 0 配 ARMA&#xA;由使用者決定做法" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="10" y="560" width="230" height="80" as="geometry" /></mxCell>
        <mxCell id="OK" value="進入階數識別" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f2fd;strokeColor=#1565c0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="300" y="415" width="160" height="60" as="geometry" /></mxCell>
        <mxCell id="U" value="列出 ADF 與 KPSS 的統計量、&#xA;p 值與結論&#xA;由使用者決定 d" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="620" y="410" width="260" height="80" as="geometry" /></mxCell>
        <mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="P" target="R"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="R" target="C1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="500" y="230" /><mxPoint x="125" y="230" /></Array></mxGeometry></mxCell>
        <mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="R" target="C2"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="500" y="230" /><mxPoint x="375" y="230" /></Array></mxGeometry></mxCell>
        <mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="R" target="C3"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="500" y="230" /><mxPoint x="625" y="230" /></Array></mxGeometry></mxCell>
        <mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="R" target="C4"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="500" y="230" /><mxPoint x="875" y="230" /></Array></mxGeometry></mxCell>
        <mxCell id="e6" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="C1" target="T"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e7" value="是" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="T" target="TS"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e8" value="否" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="T" target="OK"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e9" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="C3" target="U"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="625" y="370" /><mxPoint x="750" y="370" /></Array></mxGeometry></mxCell>
        <mxCell id="e10" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="C4" target="U"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="875" y="370" /><mxPoint x="750" y="370" /></Array></mxGeometry></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
